<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cycle Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        html {
            box-sizing: border-box;
        }
        *, *:before, *:after {
            box-sizing: inherit;
        }
        body {
            margin: 0;
            font-family: "Inter", sans-serif;
            overflow: hidden;
            height:560px
        }

        .fixed-size-container {
            width: 800px;
            height: 480px;
        }
        .section-divider:not(:last-child) {
            border-bottom: 1px solid black;
            padding-bottom: 0.5rem;
        }
        .good-bg {
            background-color: #3A5B46;
        }
        .bad-bg {
            background-color: #9C484B;
        }
        .maybe-bg {
            background-color: #D0BE47;
        }
        .weather-icon {
            width: 150px;
            height: 150px;
        }
    </style>
</head>
<body class="bg-blue-100">

    <div class="fixed-size-container bg-white grid grid-cols-2 grid-rows-[auto_1fr]">

        <div class="col-span-2 px-4 pt-4">
             <h1 class="text-2xl font-bold text-left text-black mb-4">
                {{date_title}}
            </h1>
        </div>

        <div class="flex flex-col px-4 gap-4">
            <div class="flex-1 relative {{morning_conditions}}-bg rounded-lg flex flex-row justify-between items-center p-3">
                <div class="flex flex-col items-start">
                    <img src="{{morning_image_url}}" alt="Morning Weather Icon" class="rounded-md weather-icon">
                </div>
                <div class="flex flex-col items-center flex-grow text-white">
                    <p class="text-3xl font-bold">{{morning_temperature}}°</p>
                    <p class="text-lg">{{morning_reason}}</p>
                </div>
                <h2 class="absolute bottom-2 right-2 text-base font-semibold text-white">{{morning_time}}</h2>
            </div>

            <div class="flex-1 relative {{afternoon_conditions}}-bg rounded-lg flex flex-row justify-between items-center p-3">
                 <div class="flex flex-col items-start">
                    <img src="{{afternoon_image_url}}" alt="Evening Weather Icon" class="rounded-md weather-icon">
                </div>
                <div class="flex flex-col items-center justify-center flex-grow text-white">
                    <p class="text-3xl font-bold">{{afternoon_temperature}}°F</p>
                    <p class="text-lg">{{afternoon_reason}}</p>
                </div>
                <h2 class="absolute bottom-2 right-2 text-base font-semibold text-white">{{afternoon_time}}</h2>

            </div>
        </div>

        <div class="flex flex-col px-4 gap-4">
            <div class="section-divider">
                <h3 class="text-lg font-semibold text-black mb-2">Today</h3>
                 <div class="p-2 bg-white rounded-lg">
                    {% if not today_events %}
                        <p class="text-gray-500 pl-6">Empty</p>
                    {% endif %}
                    <ul class="list-disc list-inside text-black text-base">
                        {% for event in today_events %}
                            <li>{{ event }}</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>

            <div class="section-divider">
                <h3 class="text-lg font-semibold text-black mb-2">Tomorrow</h3>
                 <div class="p-2 bg-white rounded-lg">
                    {% if not tomorrow_events %}
                        <p class="text-gray-500 pl-6">Empty</p>
                    {% endif %}
                    <ul class="list-disc list-inside text-black text-base">
                        {% for event in tomorrow_events %}
                            <li>{{ event }}</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>

            <div> 
                {% if future_events %}
                <h3 class="text-lg font-semibold text-black mb-2">Soon</h3>
                 <div class="p-2 bg-white rounded-lg">
                    <ul class="list-disc list-inside text-black text-base">
                        {% for event in future_events %}
                            <li>{{ event }}</li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</body>
</html>
